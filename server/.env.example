# .env.example — Copie este arquivo para .env e preencha os valores reais.
# ATENÇÃO: Nunca versione o .env com valores reais.

# ── Banco de Dados ──────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=SENHA_AQUI
DB_NAME=plano_contas

# ── Servidor ────────────────────────────────────────────────────────────────
PORT=3001

# ── JWT ─────────────────────────────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=TROQUE_POR_UM_SEGREDO_LONGO_E_ALEATORIO
JWT_EXP=8h

# ── CORS ────────────────────────────────────────────────────────────────────
# Em produção, defina aqui a origem exata da sua aplicação (ex: https://app.exemplo.com.br)
# Deixe vazio apenas para desenvolvimento local
API_ORIGIN=

# ── Ambiente ────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Cookies ─────────────────────────────────────────────────────────────────
# Defina como true em produção (HTTPS obrigatório)
COOKIE_SECURE=false
