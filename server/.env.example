# .env.example — Copie este arquivo para .env e preencha os valores reais.
# ATENÇÃO: Nunca versione o .env com valores reais.

# ── Banco de Dados ──────────────────────────────────────────────────────────
# Railway MySQL: use os valores do painel Railway → Variáveis do serviço MySQL
# As variáveis ${{MySQL.*}} são injetadas automaticamente pelo Railway quando
# você adiciona o plugin MySQL e usa a referência no serviço da app.
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_USER=${{MySQL.MYSQLUSER}}
DB_PASS=${{MySQL.MYSQLPASSWORD}}
DB_NAME=${{MySQL.MYSQLDATABASE}}

# Para desenvolvimento local (sobrescreve as variáveis acima no .env local):
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASS=SENHA_AQUI
# DB_NAME=plano_contas

# ── Servidor ────────────────────────────────────────────────────────────────
# Railway injeta PORT automaticamente — não defina manualmente em produção
PORT=3001

# ── JWT ─────────────────────────────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=TROQUE_POR_UM_SEGREDO_LONGO_E_ALEATORIO
JWT_EXP=8h

# Rotação de chave JWT: defina JWT_SECRET_PREV com o segredo antigo durante transição
# JWT_SECRET_PREV=

# ── CORS ────────────────────────────────────────────────────────────────────
# Em produção defina a URL pública do Railway (ex: https://seu-app.up.railway.app)
API_ORIGIN=

# ── Ambiente ────────────────────────────────────────────────────────────────
NODE_ENV=production

# ── Cookies ─────────────────────────────────────────────────────────────────
# Deve ser true em produção (Railway serve via HTTPS)
COOKIE_SECURE=true

# ── Criptografia de dados sensíveis (CPF/CNPJ) ─────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPT_KEY=TROQUE_POR_UMA_CHAVE_DE_32_BYTES_HEX
